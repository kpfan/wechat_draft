<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <AppHostDotNetSearch>AppRelative;EnvironmentVariable;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>../../.tools/dotnet</AppHostRelativeDotNet>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WechatDraft</AssemblyName><RootNamespace>WechatDraft.App</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" PrivateAssets="all" />
    <ProjectReference Include="../WechatDraft.Core/WechatDraft.Core.csproj" />
    <ProjectReference Include="../WechatDraft.Windows/WechatDraft.Windows.csproj" />
    <Content Include="../../config/blessing_examples.json" Link="config/blessing_examples.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
